%option noyywrap

%option prefix="regex_yy"

%top{
#include <charconv>
#include <cstdint>
#include <cstring>
#include <stdexcept>
#include <string>
}

%{
#define YY_DECL int yylex()

#include <minizinc/support/regex.hh>

%}

%%

[ \t\n] { /* ignore white space */ }
[0-9]+  {
  const char* end = regex_yytext + std::strlen(regex_yytext);
  if (std::from_chars(regex_yytext, end, regex_yylval.iValue).ec != std::errc()) {
    throw std::out_of_range("Integer out of range in regular expression: '" + std::string(regex_yytext) + "'");
  }
  return R_INTEGER;
}
"|"     { return R_UNION; }
"+"     { return R_PLUS; }
"*"     { return R_STAR; }
"("     { return R_GROUP_OPEN; }
")"     { return R_GROUP_CLOSE; }
"?"     { return R_OPTIONAL; }
"{"     { return R_QUANT_OPEN; }
"}"     { return R_QUANT_CLOSE; }
","     { return R_COMMA; }
"."     { return R_ANY; }
"["     { return R_CLASS_OPEN; }
"]"     { return R_CLASS_CLOSE; }
"-"     { return R_CLASS_RANGE; }
"^"     { return R_CLASS_NEG; }

.   {
  /* Catch all */
  throw std::runtime_error("Illegal token in regular expression: '" + std::string(regex_yytext) + "'");
}

%%
